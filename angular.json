{
	"$schema": "node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"schematics": {
		"@schematics/angular:*": {
			"style": "scss",
			"skipTests": true
		}
	},
	"projects": {
		"app": {
			"cli": {
				"packageManager": "pnpm"
			},
			"projectType": "application",
			"root": "src/app",
			"sourceRoot": "src/app/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"preserveSymlinks": true,
						"outputPath": "dist/app",
						"index": "src/app/src/index.html",
						"browser": "src/app/src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "src/app/public"
							},
							{
								"glob": "**/*",
								"input": "src/app/src/assets"
							}
						],
						"styles": [
							"node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
							"src/app/style.css",
							"src/app/src/app.scss"
						]
					},
					"configurations": {
						"production": {
              "sourceMap": true,
              "tsConfig": "tsconfig.app.json",
							"outputHashing": "all",
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "2MB",
									"maximumError": "4MB"
								}
							]
						},
						"development": {
							"tsConfig": "tsconfig.app.json",
							"aot": true,
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"options": {
						"proxyConfig": "src/app/proxy.conf.cjs"
					},
					"configurations": {
						"production": {
							"buildTarget": "app:build:production"
						},
						"development": {
							"buildTarget": "app:build:production"
						}
					},
					"defaultConfiguration": "development"
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n",
					"options": {
						"buildTarget": "app:build"
					}
				}
			}
		}
	},
	"cli": {
		"analytics": false
	}
}